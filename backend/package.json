{
  "name": "freelance-crm-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node qa/runTests.js",
    "verify:production": "node qa/verifyProductionDeployment.js",
    "seed:initial": "node src/scripts/seedInitialDemoWorkspaces.js",
    "seed:demo": "node src/scripts/seedCompleteDemoData.js",
    "demo:reset": "node src/scripts/resetDemoData.js",
    "saas:migration:status": "node src/scripts/migrateM2WWorkspace.js --status",
    "saas:migration:dry-run": "node src/scripts/migrateM2WWorkspace.js --dry-run",
    "saas:migration:execute": "node src/scripts/migrateM2WWorkspace.js --execute",
    "saas:migration:verify": "node src/scripts/migrateM2WWorkspace.js --verify",
    "saas:migration:rollback": "node src/scripts/migrateM2WWorkspace.js --rollback",
    "test:isolated": "node qa/runTests.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.13.15",
    "mongoose": "^8.9.5",
    "multer": "^2.4.0",
    "nodemailer": "^10.2.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
