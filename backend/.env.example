PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/freelance_automation_crm
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
FRONTEND_URL=http://localhost:5173
# Optional comma-separated additional exact frontend origins (e.g. preview domains)
CORS_ALLOWED_ORIGINS=
IMPORT_MAX_FILE_BYTES=10485760
IMPORT_MAX_ROWS=10000

# Optional AI writing assistant (OpenAI-compatible chat completions endpoint)
# Leave unset to show "AI Not Configured" in the template builder.
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=your-model
# AI_API_KEY=server-side-secret
# TEMPLATE_AI_HOURLY_LIMIT=20
